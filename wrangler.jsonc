{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andreas-nyberg",
  "compatibility_date": "2026-05-14",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/pomperipossa/*.mp3",
      "/pomperipossa/*.mp4"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
